# PhishGuard - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Data files (large)
data/*.csv
data/*.zip

# Model files (generated)
models/*.joblib
models/*.json

# OS
Thumbs.db
.DS_Store
